JWT_SECRET=
PORT=5000
# Comma-separated list of front-end origins allowed to call the API, e.g.
# http://localhost:3000,http://localhost:3001
CLIENT_URL=

# Postgres connection string, e.g.:
# postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public
# Works with any Postgres host (Neon, Supabase, Railway, RDS, local, ...).
DATABASE_URL=
